<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>User Dashboard</title>
  <!-- <link rel="stylesheet" href="/css/style.css"> -->
  <link rel="stylesheet" href="/css/newheader.css">
  <link rel="stylesheet" href="/css/profile.css">
  <link rel="stylesheet" href="/css/dashColor.css">
  <link rel="stylesheet" href="/css/section.css">
  <link rel="stylesheet" href="/css/dashboardmainContent.css">
</head>

<body>

  <div class="page-wrapper">

    <aside class="sidebar" id="sidebar">
      <ul>
        <li><a href="/dashboard">Dashboard</a></li>
        <li><a href="/assignments">Assignments</a></li>
        <li><a href="/saved">Saved Documents</a></li>
        <li><a href="/profile">Profile</a></li>

        <li class="mobile-only"><a href="/api/pdfUpload">Upload</a></li>
        <li class="mobile-only"><a href="/savedAssignmemt">Saved</a></li>
        <li class="mobile-only"><a href="/post-assignment">+ Post New</a></li>
      </ul>
    </aside>


    <div class="main-content">

      <header class="custom-header">
        <div class="header-left">
          <button class="menu-toggle" id="menuToggle">☰</button>
          <h1 class="logo">FREELANCE</h1>
        </div>

        <div class="header-right">
          <a href="/api/pdfUpload" class="btn">Upload</a>
          <a href="/savedAssignmemt" class="btn">Saved</a>
          <a href="/post-assignment" class="btn">+ Post New</a>

          <div class="user-avatar-wrapper">
            <div class="user-avatar">
              <%= user.username[0].toUpperCase() %>
            </div>
            <div class="avatar-info">
              <p><strong>Username:</strong>
                <%= user.username %>
              </p>
              <p><a href="/profile">View Account</a></p>
              <p><a href="/logout">Sign Out</a></p>
            </div>
          </div>
        </div>
      </header>

      <main class="content profile-layout">

        <div class="editor-layout">

          <% const pdfCards=[]; assignments.forEach(assignment=> {
            if (assignment.pdfs && assignment.pdfs.length > 0) {
            assignment.pdfs.forEach(pdf => {
            pdfCards.push({
            assignmentId: assignment._id,
            title: assignment.title,
            file: pdf.file
            });
            });
            }
            });
            %>

            <section class="pdf-card-panel">
              <h3>My PDFs</h3>

              <% if (pdfCards.length> 0) { %>
                <div class="pdf-card-list">
                  <% pdfCards.forEach(pdf=> { %>
                    <div class="pdf-card" onclick="loadAssignment('<%= pdf.assignmentId %>')">
                      <div class="pdf-icon">PDF</div>
                      <div class="pdf-info">
                        <h4>
                          <%= pdf.title.length> 50 ? pdf.title.slice(0,50) + "..." : pdf.title %>
                        </h4>
                        <p>
                          <%= pdf.file.filename %>
                        </p>
                      </div>
                    </div>
                    <% }) %>
                </div>
                <% } else { %>
                  <p class="empty-text">No PDFs uploaded yet.</p>
                  <% } %>
            </section>

            <section class="assignment-editor">
              <h3>Edit Assignment</h3>

              <form id="editAssignmentForm">
                <label>Title</label>
                <input type="text" id="title" />

                <label>Description</label>
                <textarea id="description"></textarea>

                <label>Starting Price</label>
                <input type="number" id="price" />

                <label>Subject</label>
                <input type="text" id="subject" />

                <label>Deadline</label>
                <input type="date" id="deadline" />

                <label>Category</label>
                <input type="text" id="category" />

                <button type="submit">Update Assignment</button>
              </form>
            </section>

        </div>

      </main>
      <%- include('partials/footer') %>
    </div>
  </div>

  <script src="/js/dashboard_edit_show.js"></script>
</body>
</html>