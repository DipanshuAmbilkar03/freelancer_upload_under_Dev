<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>User Dashboard - Freelancer Bidding</title>
  <link rel="stylesheet" href="/css/newheader.css">
  <link rel="stylesheet" href="/css/dashboard-redesign.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body>

  <div class="page-wrapper">

    <!-- SIDEBAR -->
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-header">
        <h2 class="logo">FREELANCE</h2>
      </div>
      <nav class="sidebar-nav">
        <a href="/dashboard" class="nav-link active">
          <i class="fas fa-house"></i> Home
        </a>
        <a href="/assignments" class="nav-link">
          <i class="fas fa-tasks"></i> Assignments
        </a>
        <a href="/post-assignment" class="nav-link">
          <i class="fas fa-briefcase"></i> Projects
        </a>
        <a href="/saved" class="nav-link">
          <i class="fas fa-gavel"></i> My Bids
        </a>
        <a href="/profile" class="nav-link">
          <i class="fas fa-user"></i> Profile
        </a>
      </nav>
      <div class="sidebar-footer">
        <a href="/logout" class="nav-link logout">
          <i class="fas fa-sign-out-alt"></i> Logout
        </a>
      </div>
    </aside>


    <!-- MAIN CONTENT -->
    <div class="main-content">

      <!-- HEADER -->
      <header class="custom-header">
        <div class="header-left">
          <button class="menu-toggle" id="menuToggle">
            <i class="fas fa-bars"></i>
          </button>
          <div class="brand-mark"><%= user.username[0].toUpperCase() %></div>
        </div>

        <div class="header-right">
          <a href="/profile" class="top-btn">Profile</a>
          <a href="/logout" class="top-btn">Logout</a>
        </div>
      </header>

      <!-- MAIN CONTENT AREA -->
      <main class="dashboard-content">
        <section class="page-title-wrap">
          <h1>Assignments</h1>
          <p>Available Assignments</p>
        </section>

        <% if (message) { %>
          <div class="dashboard-alert alert-<%= message.type === 'success' ? 'success' : 'error' %>">
            <i class="fas fa-<%= message.type === 'success' ? 'check-circle' : 'triangle-exclamation' %>"></i>
            <span><%= message.text %></span>
          </div>
        <% } %>

        <section class="assignments-section">
          <div class="section-header">
            <h2><i class="fas fa-folder-open"></i> Your Assignments (<%= assignments.length %>)</h2>
          </div>

          <% if (assignments.length > 0) { %>
            <div class="assignments-list">
              <% assignments.forEach(a => { %>
                <% const statusText = (a.status || 'open').toUpperCase(); %>
                <% const bidderCount = a.bidsCount || (a.bids ? a.bids.length : 0); %>
                <% const price = a.startingPrice || a.price || 0; %>
                <% const authorName = a.username || (a.user && a.user.username) || user.username; %>
                <% const hasImage = a.userImage || (a.user && a.user.avatar); %>
                <article class="assignment-card" data-status="<%= statusText %>">
                  <div class="card-left">
                    <% if (hasImage) { %>
                      <img src="<%= a.userImage || a.user.avatar %>" alt="User" class="user-image">
                    <% } else { %>
                      <div class="user-image user-fallback">
                        <%= authorName[0].toUpperCase() %>
                      </div>
                    <% } %>
                    <p class="user-name"><%= authorName %></p>
                  </div>

                  <div class="card-middle">
                    <h3 class="assignment-title"><%= a.title %></h3>
                    <p class="assignment-description">
                      <%= a.description
                        ? (a.description.length > 160 ? a.description.slice(0, 160) + '...' : a.description)
                        : 'No additional description provided for this assignment.' %>
                    </p>

                    <div class="meta-row">
                      <span class="meta-pill"><i class="fas fa-book"></i> <%= a.subject || 'General' %></span>
                      <span class="meta-pill"><i class="fas fa-layer-group"></i> <%= a.category || 'Uncategorized' %></span>
                    </div>

                    <div class="meta-bottom-row">
                      <span class="status-pill <%= statusText === 'OPEN' ? 'is-open' : '' %>">
                        <span class="dot"></span> <%= statusText %>
                      </span>
                      <span class="time-meta" title="Posted/Deadline time">
                        <i class="fas fa-clock"></i>
                        <%= new Date(a.deadline || a.createdAt).toLocaleString() %>
                      </span>
                      <span class="bids-meta">
                        <i class="fas fa-gavel"></i> <%= bidderCount %> bids
                      </span>
                    </div>
                  </div>

                  <div class="card-right">
                    <p class="price-label">Starting Price</p>
                    <p class="price-value" title="Starting offer price">$<%= price %></p>
                    <button class="bookmark-btn" type="button" title="Save assignment">
                      <i class="far fa-bookmark"></i>
                    </button>

                    <form action="/add-files/<%= a._id %>" method="POST" enctype="multipart/form-data" class="upload-more-form">
                      <label for="assignmentFiles-<%= a._id %>" class="mini-upload-label" title="Upload more files">
                        <i class="fas fa-paperclip"></i> Add Files
                      </label>
                      <input
                        id="assignmentFiles-<%= a._id %>"
                        type="file"
                        name="assignmentFiles"
                        class="mini-upload-input"
                        multiple
                        accept=".pdf,.doc,.docx,.txt,.jpg,.png,.jpeg"
                      >
                      <button type="submit" class="mini-upload-submit">Upload</button>
                    </form>

                    <div class="card-actions">
                      <a href="/assignments/<%= a._id %>" class="btn btn-secondary btn-sm">
                      <i class="fas fa-eye"></i> View
                      </a>
                      <a href="/edit/<%= a._id %>" class="btn btn-secondary btn-sm">
                        <i class="fas fa-edit"></i> Edit
                      </a>
                    </div>
                  </div>
                </article>
              <% }); %>
            </div>
          <% } else { %>
            <div class="empty-state">
              <i class="fas fa-inbox"></i>
              <h3>No Assignments Yet</h3>
              <p>Start by uploading your first assignment above or <a href="/post-assignment">post a new one</a>.</p>
            </div>
          <% } %>
        </section>

      </main>

      <!-- FOOTER -->
      <footer class="dashboard-footer">
        <p>&copy; 2025 Freelancer Bidding Platform. All rights reserved.</p>
      </footer>
    </div>
  </div>

  <!-- SIDEBAR TOGGLE SCRIPT -->
  <script>
    document.getElementById('menuToggle').addEventListener('click', function() {
      const sidebar = document.getElementById('sidebar');
      sidebar.classList.toggle('show');
    });

    // Close sidebar when clicking outside on mobile
    document.addEventListener('click', function(event) {
      const sidebar = document.getElementById('sidebar');
      const menuToggle = document.getElementById('menuToggle');
      if (window.innerWidth <= 768 && 
          !sidebar.contains(event.target) && 
          !menuToggle.contains(event.target)) {
        sidebar.classList.remove('show');
      }
    });

    document.querySelectorAll('.bookmark-btn').forEach(function(button) {
      button.addEventListener('click', function() {
        this.classList.toggle('active');
        const icon = this.querySelector('i');
        icon.classList.toggle('far');
        icon.classList.toggle('fas');
      });
    });

    document.querySelectorAll('.mini-upload-input').forEach(function(input) {
      input.addEventListener('change', function() {
        const label = this.closest('.upload-more-form').querySelector('.mini-upload-label');
        const count = this.files ? this.files.length : 0;
        label.innerHTML = count > 0 ? '<i class="fas fa-paperclip"></i> ' + count + ' file(s)' : '<i class="fas fa-paperclip"></i> Add Files';
      });
    });
  </script>

</body>

</html>