<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Assignments - Freelancer Bidding Site</title>
    <link rel="stylesheet" href="/css/assignments.css">
    <link rel="stylesheet" href="/css/assignments2.css">
    <script src="/js/dashboard.js" defer></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"
        integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>

<body>
    <header class="header">
        <div class="logo" id="logo">
            <span class="logo-circle">F</span>
            <span class="logo-text">FREELANCE</span>
        </div>
        <div class="top-bar">
            <div class="user-actions">
                <button class="toggle-btn" id="toggleBtn">☰</button>
                <a href="/dashboard">Profile</a>
                <a href="/logout">Logout</a>
            </div>
        </div>
    </header>

    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
        <nav>
            <a href="/">Home</a>
            <a href="/assignments">Assignments</a>
            <a href="/projects">Projects</a>
            <a href="/bids">My Bids</a>
            <a href="/profile">Profile</a>
        </nav>
        <nav>
            <a href="/dashboard">Profile</a>
        </nav>
    </aside>

    <!-- Main -->
    <div class="main">
        <h1>Assignments</h1>
        <h2>Available Assignments</h2>
        <div class="grid">
            <% if (!assignments || assignments.length===0) { %>
                <p>No assignments available.</p>
                <% } else { %>
                    <% assignments.forEach(a=> { %>
                        <div class="card horizontal-card">
                            <div class="avatar-section">
                                <img src="<%= a.postedBy?.avatar || '/assets/pfp.png' %>" alt="User Avatar"
                                    class="avatar" />
                                <span class="username">
                                    <%= a.postedBy?.username || 'Deleted User' %>
                                </span>
                            </div>

                            <div class="content-section">
                                <h3 class="card-title">
                                    <a href="/assignments/<%= a._id %>">
                                        <%= a.title %>
                                    </a>
                                </h3>

                                <p class="card-desc">
                                    <%= a.description?.length> 100
                                        ? a.description.slice(0,100) + '...'
                                        : a.description %>
                                </p>

                                <div class="meta">
                                    <span><strong>Subject:</strong>
                                        <%= a.subject || 'N/A' %>
                                    </span>
                                    <span><strong>Category:</strong>
                                        <%= a.category || 'N/A' %>
                                    </span>
                                </div>

                                <div class="extra-meta">
                                    <span class="status open">
                                        <i class="fa-solid fa-circle"></i>
                                        <%= a.status %>
                                    </span>

                                    <span class="deadline">
                                        <i class="fa-regular fa-clock"></i>
                                        <%= a.deadline ? a.deadline : 'No deadline' %>
                                    </span>

                                    <span class="bids">
                                        <i class="fa-solid fa-gavel"></i>
                                        <%= a.bidCount || 0 %> bids
                                    </span>
                                </div>

                            </div>

                            <div class="price-section">
                                <div>
                                    <div class="price">₹ <%= a.startingPrice %>
                                    </div>
                                    <div><small>Starting Price</small></div>
                                </div>

                                <div class="saved">
                                    <%
                                    const isSaved =
                                        user &&
                                        Array.isArray(user.savedAssignments) &&
                                        user.savedAssignments.some(
                                            id => id.toString() === a._id.toString()
                                        );
                                    %>
                                    
                                    <button class="bookmark-btn <%= isSaved ? 'active' : '' %>" data-id="<%= a._id %>">
                                        <i class="fa-regular fa-bookmark"></i>
                                    </button>
                                </div>
                            </div>


                        </div>
                        <% }) %>
                            <% } %>
        </div>

        <footer>
            <p>&copy; 2025 Freelancer Bidding Site. All rights reserved.</p>
        </footer>
    </div>

    <script>
        const sidebar = document.getElementById('sidebar');
        const toggleBtn = document.getElementById('toggleBtn');
        const header = document.querySelector('.header');

        toggleBtn.addEventListener('click', () => {
            if (window.innerWidth <= 768) {
                sidebar.classList.toggle('show'); // slide in/out sidebar on mobile
            } else {
                sidebar.classList.toggle('collapsed');
                header.classList.toggle('collapsed');
            }
        });

        document.querySelectorAll(".bookmark-btn").forEach(btn => {
        btn.addEventListener("click", async (e) => {
            e.preventDefault();

            console.log("BOOKMARK CLICKED", btn.dataset.id);

            const assignmentId = btn.dataset.id;

            const res = await fetch(`/assignments/${assignmentId}/save`, {
            method: "POST",
            credentials: "same-origin"
            });

            console.log("RESPONSE STATUS:", res.status);

            const text = await res.text();
            console.log("RESPONSE BODY:", text);
        });
    });

    </script>
</body>

</html>