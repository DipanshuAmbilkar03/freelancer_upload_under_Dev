<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= assignment.title %> - Assignment Detail</title>
  <link rel="stylesheet" href="/css/detail.css">
</head>
<body>
  <header class="custom-header">
    <div class="header-left">
      <div class="user-avatar">F</div>
      <span class="logo">freelancer</span>
    </div>

    <div class="header-right">
      <a href="/profile" class="btn black-btn">Profile</a>
      <a href="/logout" class="btn black-btn">Logout</a>
    </div>
  </header>


  <div class="container">
    <h2>
      <%= assignment.title %>
      <span class="status <%= assignment.status.toLowerCase() %>">
        <%= assignment.status %>
      </span>
    </h2>

    <img 
            class="card-img" 
            src="<%= (typeof assignment.image === 'string') 
                    ? assignment.image 
                    : (assignment.image && assignment.image.path ? assignment.image.path : 'https://via.placeholder.com/400x360') %>" 
            alt="assignment image">

    <p><strong>Description:</strong> <%= assignment.description %></p>
    <p><strong>Starting Price:</strong> Rs.<%= assignment.startingPrice %></p>
    <p><strong>Subject:</strong> <%= assignment.subject || 'N/A' %></p>
    <p><strong>Category:</strong> <%= assignment.category || 'N/A' %></p>
    <p><strong>Deadline:</strong> <%= assignment.deadline ? assignment.deadline.toLocaleDateString() : 'N/A' %></p>
    <p><strong>Posted By:</strong> <%= assignment.postedBy.username %></p>
  </div>

</body>
</html>
